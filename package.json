{
  "name": "twist-turbo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "lint": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run lint",
    "format": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run format",
    "dev": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run dev",
    "build": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run build",
    "build-game": "bash ./scripts/build-game.sh",
    "preview": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run preview",
    "real-build-storybook": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run real-build-storybook",
    "storybook": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run storybook",
    "publish-packages": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run build lint test && changeset version && changeset publish",
    "e2e": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run e2e",
    "e2e-smoke": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run e2e-smoke",
    "e2e-mobile": "PATH=\"$(dirname \"$(node -p 'process.execPath')\"):$PATH\" turbo run e2e-mobile",
    "mock-rgs": "node ./mock-rgs/server.mjs",
    "forest-gang:sim": "node ./scripts/forest-gang-sim.mjs",
    "forest-gang:testmath": "node ./scripts/test-forest-gang-regression.mjs",
    "forest-gang:genmath": "node ./scripts/generate-forest-gang-math-artifacts.mjs",
    "forest-gang:validatemath": "node ./scripts/validate-forest-gang-artifacts.mjs"
  },
  "dependencies": {
    "eslint": "9.21.0",
    "eslint-config-custom": "workspace:*",
    "prettier": "3.5.2",
    "prettier-plugin-svelte": "3.3.3",
    "turbo": "2.4.4"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "packageManager": "pnpm@10.5.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "svelte-preprocess"
    ]
  }
}
